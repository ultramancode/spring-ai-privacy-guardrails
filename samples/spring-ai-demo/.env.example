# Copy this file to .env and add credentials for an OpenAI-compatible endpoint.
# The local .env file is ignored by Git.
# This example uses Gemini through its OpenAI-compatible endpoint.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_COMPATIBLE_MODEL=gemini-2.5-flash
